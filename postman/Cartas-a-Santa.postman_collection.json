{
  "info": {
    "name": "Polo Norte · Cartas a Santa",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con el simulador local. Completar los dos tokens con valores locales."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "tokenJefe",
      "value": ""
    },
    {
      "key": "tokenElfo",
      "value": ""
    },
    {
      "key": "cartaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Registrar carta",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/cartas",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"remitente\": \"Valentina Pérez\",\n  \"edad\": 9,\n  \"ciudad\": \"Guayaquil\",\n  \"regalos\": [\n    \"Libro\",\n    \"Tren\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"cartaId\", pm.response.json().id);",
              "pm.test(\"estado = RECIBIDA\", () => pm.expect(pm.response.json().estado).to.eql(\"RECIBIDA\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Consultar detalle",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cartas/{{cartaId}}",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Filtrar y comprobar privacidad",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/cartas?estado=RECIBIDA&ciudad=Guayaquil",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Remitente abreviado y edad oculta\", () => { const carta = pm.response.json().find(x => x.id == pm.collectionVariables.get(\"cartaId\")); pm.expect(carta.remitente).to.eql(\"Valentina P.\"); pm.expect(carta).not.to.have.property(\"edad\"); });"
            ]
          }
        }
      ]
    },
